{
  "productName": "Hisn",
  "version": "0.1.0",
  "identifier": "local.hisn.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "حصن",
        "width": 1020,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "create": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Hisn",
    "shortDescription": "Scan and run untrusted programs",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
